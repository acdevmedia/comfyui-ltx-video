# Runtime variables (alphabetical)
AI_TOOLKIT_AUTH=SET_A_STRONG_PASSWORD
AUTO_DOWNLOAD_ADAPTERS=true
AUTO_DOWNLOAD_MODELS=true
BACKUP_RECHECK_SECONDS=120
BACKUP_SETTLE_SECONDS=8
BACKUP_SOURCE_DIR=/workspace/ComfyUI/output
COMFYUI_PORT=8188
ENABLE_JUPYTER=false
HF_HOME=/workspace/.cache/huggingface
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=
JUPYTER_TOKEN=
LOG_LEVEL=INFO
LTX_DEFAULT_ASPECT_RATIO=16:9
LTX_DEFAULT_DURATION=30
LTX_DEFAULT_FPS=24
LTX_DEFAULT_MEGAPIXELS=0.5
LTX_DEFAULT_WORKFLOW=01_LTX25_Image_to_Video
LTX_MODEL_VARIANT=int8-convrot
LTX_VERSION=ltx-2.5
PUBLIC_KEY=
REALTIME_BACKUP=false
S3_ACCESS_KEY_ID=
S3_BUCKET=
S3_ENDPOINT_URL=https://sfo3.digitaloceanspaces.com
S3_FORCE_PATH_STYLE=false
S3_PREFIX=ltx25-studio
S3_REGION=sfo3
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_SSE=none
S3_STORAGE_CLASS=STANDARD
TINI_SUBREAPER=1

# Local GHCR release publishing only; never pass these to Docker build or RunPod.
GHCR_USERNAME=
GITHUB_PACKAGES_PAT=
