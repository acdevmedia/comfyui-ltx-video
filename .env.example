# Hugging Face: accept the gated LTX-2.5 model terms before launching.
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# Studio defaults
LTX_VERSION=ltx-2.5
COMFYUI_PORT=8188
LTX_MODEL_VARIANT=int8-convrot
LTX_DEFAULT_WORKFLOW=01_LTX25_Image_to_Video
LTX_DEFAULT_DURATION=30
LTX_DEFAULT_FPS=24
LTX_DEFAULT_MEGAPIXELS=0.5
LTX_DEFAULT_ASPECT_RATIO=16:9
AUTO_DOWNLOAD_MODELS=true
AUTO_DOWNLOAD_ADAPTERS=true
HF_HOME=/workspace/.cache/huggingface

# Optional Jupyter service (port 8888)
ENABLE_JUPYTER=false
JUPYTER_TOKEN=
PUBLIC_KEY=

# Real-time S3-compatible backup
REALTIME_BACKUP=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT_URL=
S3_PREFIX=ltx25-studio
S3_FORCE_PATH_STYLE=false
S3_STORAGE_CLASS=
S3_SSE=
BACKUP_SOURCE_DIR=/workspace/ComfyUI/output
BACKUP_RECHECK_SECONDS=120
BACKUP_SETTLE_SECONDS=8
SPACES_BUCKET=
SPACES_REGION=
SPACES_PREFIX=
LOG_LEVEL=INFO

# Local release publishing only; never pass this to RunPod or Docker build.
GHCR_USERNAME=
GITHUB_PACKAGES_PAT=
