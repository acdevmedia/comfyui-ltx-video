# Runtime defaults synchronized from the Runpod account template.
# Secret references are Runpod placeholders, never actual credentials.
AUTO_DOWNLOAD_ADAPTERS=false
AUTO_DOWNLOAD_MODELS=true
BACKUP_RECHECK_SECONDS=120
BACKUP_SETTLE_SECONDS=8
BACKUP_SOURCE_DIR=/workspace/ComfyUI/output
COMFYUI_PORT=8188
HF_HOME=/workspace/.cache/huggingface
HF_TOKEN={{ RUNPOD_SECRET_HUGGINGFACE_TOKEN }}
HUGGING_FACE_HUB_TOKEN={{ RUNPOD_SECRET_HUGGINGFACE_TOKEN }}
LOG_LEVEL=INFO
LTX_DEFAULT_ASPECT_RATIO=16:9
LTX_DEFAULT_DURATION=30
LTX_DEFAULT_FPS=24
LTX_DEFAULT_MEGAPIXELS=0.5
LTX_DEFAULT_WORKFLOW=01_LTX25_Image_to_Video
LTX_MODEL_VARIANT=int8-convrot
LTX_VERSION=ltx-2.5
REALTIME_BACKUP=false
S3_ACCESS_KEY_ID={{ RUNPOD_SECRET_S3_ACCESS_KEY_ID }}
S3_BUCKET=YOUR_BUCKET
S3_ENDPOINT_URL=https://sfo3.digitaloceanspaces.com
S3_FORCE_PATH_STYLE=false
S3_PREFIX=ltx25-studio
S3_REGION=sfo3
S3_SECRET_ACCESS_KEY={{ RUNPOD_SECRET_S3_SECRET_ACCESS_KEY }}
S3_SESSION_TOKEN=OPTIONAL_TEMPORARY_TOKEN
S3_SSE=none
S3_STORAGE_CLASS=STANDARD
TINI_SUBREAPER=1

# Additional optional image settings, absent from the account template.
AI_TOOLKIT_AUTH=SET_A_STRONG_PASSWORD
COMFYUI_ATTENTION=sage
ENABLE_JUPYTER=false
JUPYTER_TOKEN=
MODEL_DOWNLOAD_WORKERS=3
PUBLIC_KEY=
GHCR_USERNAME=

# Local deployment tools only. Never pass these to Docker builds or Pods.
RUNPOD_API_KEY=
GITHUB_PACKAGES_PAT=
