{
  "name": "LTX 2.5 Distilled Video and one click",
  "imageName": "ghcr.io/acdevmedia/ltx-studio:2.5",
  "category": "NVIDIA",
  "containerDiskInGb": 100,
  "dockerEntrypoint": [],
  "dockerStartCmd": [],
  "env": {
    "AI_TOOLKIT_AUTH": "SET_A_STRONG_PASSWORD",
    "AUTO_DOWNLOAD_ADAPTERS": "true",
    "AUTO_DOWNLOAD_MODELS": "true",
    "BACKUP_RECHECK_SECONDS": "120",
    "BACKUP_SETTLE_SECONDS": "8",
    "BACKUP_SOURCE_DIR": "/workspace/ComfyUI/output",
    "COMFYUI_PORT": "8188",
    "DOWNLOAD_FLUX": "false",
    "DOWNLOAD_WAN": "false",
    "ENABLE_JUPYTER": "false",
    "HF_HOME": "/workspace/.cache/huggingface",
    "HF_TOKEN": "YOUR_HUGGING_FACE_TOKEN",
    "HUGGING_FACE_HUB_TOKEN": "OPTIONAL_ALTERNATE_HF_TOKEN",
    "JUPYTER_TOKEN": "CHANGE_ME_BEFORE_ENABLING_JUPYTER",
    "LOG_LEVEL": "INFO",
    "LTX_DEFAULT_ASPECT_RATIO": "16:9",
    "LTX_DEFAULT_DURATION": "30",
    "LTX_DEFAULT_FPS": "24",
    "LTX_DEFAULT_MEGAPIXELS": "0.5",
    "LTX_DEFAULT_WORKFLOW": "01_LTX25_Image_to_Video",
    "LTX_MODEL_VARIANT": "int8-convrot",
    "LTX_VERSION": "ltx-2.5",
    "PUBLIC_KEY": "OPTIONAL_SSH_PUBLIC_KEY",
    "REALTIME_BACKUP": "false",
    "S3_ACCESS_KEY_ID": "YOUR_SPACES_ACCESS_KEY_ID",
    "S3_BUCKET": "YOUR_SPACES_BUCKET",
    "S3_ENDPOINT_URL": "https://sfo3.digitaloceanspaces.com",
    "S3_FORCE_PATH_STYLE": "false",
    "S3_PREFIX": "ltx25-studio",
    "S3_REGION": "sfo3",
    "S3_SECRET_ACCESS_KEY": "YOUR_SPACES_SECRET_ACCESS_KEY",
    "S3_SESSION_TOKEN": "OPTIONAL_SESSION_TOKEN",
    "S3_SSE": "none",
    "S3_STORAGE_CLASS": "STANDARD"
  },
  "isPublic": true,
  "isServerless": false,
  "ports": [
    "8188/http",
    "8888/http",
    "8675/http",
    "22/tcp",
    "8080/tcp",
    "22/udp",
    "8080/udp"
  ],
  "portLabels": {
    "8188/http": "ComfyUI",
    "8888/http": "JupyterLab (optional)",
    "8675/http": "Reserved legacy port",
    "22/tcp": "SSH",
    "8080/tcp": "File and proxy access",
    "22/udp": "SSH over UDP",
    "8080/udp": "Port 8080 over UDP"
  },
  "readme": "# LTX 2.5 Distilled Video and one click\n\nOne-click LTX-2.5 Distilled video and audio generation in ComfyUI. A100 80 GB is recommended. The template uses a 100 GB container disk and no persistent volume.\n\nReplace `HF_TOKEN` with your Hugging Face token and mark it as a secret. Accept the gated LTX-2.5 model terms before launching. The container automatically provisions models and workflows on startup.\n\nRunPod environment fields are listed alphabetically. S3 settings default to DigitalOcean Spaces in SFO3. Replace the bucket and access-key placeholders, mark credentials as secrets, and set `REALTIME_BACKUP=true` to enable output backup.\n\nHTTP ports: 8188, 8888, 8675. TCP ports: 22, 8080. UDP ports: 22, 8080. The image has no registry credentials or start-command override."
}
